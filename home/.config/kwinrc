[Effect-better-blur-dx]
BlurDecorations=true
BlurMatching=false
BlurMenus=true
BlurNonMatching=true
BlurStrength=4
NoiseStrength=0
WindowClasses=steam_app_*\norg.mozilla.firefox

[Effect-glide]
Duration=300
InRotationAngle=5
OutRotationAngle=5

[Effect-hidecursor]
InactivityDuration=5

[Effect-kwin4_effect_geometry_change]
Duration=300

[Effect-login]
FadeToBlack=true

[Effect-magnifier]
Height=300
Width=400

[Effect-overview]
BorderActivate=5
TouchBorderActivate=6

[Effect-shakecursor]
Magnification=2

[Effect-wobblywindows]
Drag=90
ResizeWobble=false
Stiffness=6
WobblynessLevel=2

[Effect-zoom]
MousePointer=1

[ElectricBorders]
BottomRight=ShowDesktop

[MouseBindings]
CommandWindow1=Activate, raise and pass click
CommandWindow2=Activate, raise and pass click
CommandWindow3=Activate, raise and pass click

[NightColor]
Active=true
NightTemperature=4000

[Plugins]
better_blur_dxEnabled=true
blurEnabled=false
glideEnabled=true
hidecursorEnabled=true
kwin4_effect_geometry_changeEnabled=true
mousemarkEnabled=true
scaleEnabled=false
wobblywindowsEnabled=true

[TabBox]
ShowDesktopMode=1

[TabBoxAlternative]
LayoutName=flipswitch

[Tiling]
padding=4

[TouchEdges]
Bottom=ShowDesktop
Right=ApplicationLauncher
Top=KRunner

[Wayland]
VirtualKeyboardEnabled=true

[Windows]
CenterSnapZone=10
ElectricBorderCornerRatio=0.15

[Xwayland]
Scale=1.25

[org.kde.kdecoration2]
ButtonsOnLeft=M
library=org.kde.breeze
theme=Breeze
