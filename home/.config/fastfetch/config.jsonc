{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "height": 15,
    "width": 30,
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": " ",
    "brightColor": "false"
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[36m╭───────────╮"
    },
    {
      "type": "title",
      "key": "│  User    │",
      "keyColor": "cyan",
      "format": "{user-name}"
    },
    {
      "type": "title",
      "key": "│ 󰒋 Host    │",
      "keyColor": "cyan",
      "format": "{host-name}"
    },
    {
      "type": "uptime",
      "key": "│ 󰅐 Uptime  │",
      "keyColor": "cyan"
    },
    {
      "type": "host",
      "key": "│ 󰌢 PC      │",
      "keyColor": "cyan",
      "format": "{family}"
    },
    {
      "type": "cpu",
      "key": "│ ├  CPU   │",
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "key": "│ ├  GPU   │",
      "keyColor": "cyan"
    },
    {
      "type": "display",
      "key": "│ ├ 󰍹 Disp  │",
      "keyColor": "cyan",
      "format": "{name} {inch}\" {width}x{height} @ {refresh-rate}Hz"
    },
    {
      "type": "disk",
      "key": "│ ├  Disk  │",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "│ ╰  RAM   │",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "\u001b[36m├───────────┤"
    },
    {
      "type": "os",
      "key": "│  OS      │",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "│  Kernel  │",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "│ 󰏖 Pkgs    │",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "│  Term    │",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "│  Shell   │",
      "keyColor": "cyan"
    },
    {
      "type": "de",
      "key": "│  DE      │",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "│  WM      │",
      "keyColor": "cyan"
    },
    {
      "type": "wmtheme",
      "key": "│ 󰉼 Theme   │",
      "keyColor": "cyan"
    },
    {
      "type": "cursor",
      "key": "│ 󰇀 Cursor  │",
      "keyColor": "cyan"
    },
    {
      "type": "command",
      "key": "│ 󱑌 OS age  │",
      "keyColor": "cyan",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "colors",
      "key": "│ 󰏘 Colors  │",
      "keyColor": "cyan",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "\u001b[36m╰───────────╯"
    }
  ]
}
